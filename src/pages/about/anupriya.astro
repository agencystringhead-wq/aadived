---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumb from '../../components/page/Breadcrumb.astro';
import Bento from '../../components/page/Bento.astro';
import Certificate from '../../components/page/Certificate.astro';
import { site } from '../../data/site';
import { reviews } from '../../data/reviews';
import { personSchema } from '../../data/schema';
import wide from '../../assets/images/anupriya/anupriya-wide.webp';
import square from '../../assets/images/anupriya/anupriya-inhale-exhale-1080.webp';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Meet Anupriya' },
];
const who = [
  { title: 'Beginners to experienced', text: 'Whether you are stepping onto a mat for the first time or returning to a long practice, each session is shaped around you.' },
  { title: 'Busy minds', text: 'Slow, grounding practice for long workdays, so you leave lighter than you arrived.' },
  { title: 'Rebuilding balance', text: 'For the stretch after a big life change, with a pace that suits where you are now.' },
  { title: 'Expecting mothers', text: 'One-on-one prenatal yoga, private and customised for each trimester. Please consult your doctor first.' },
];
const principles = [
  { t: 'Clear and patient', p: 'Students say she explains each asana so clearly and patiently.' },
  { t: 'Shaped around you', p: 'Studio or online, group or one-on-one. The practice is matched to your body, goals and schedule.' },
  { t: 'Calm that carries off the mat', p: 'Asana, breathwork and grounding practices are blended so the calm follows you into your day.' },
];
const practices = [
  { label: 'Guided Yoga', href: '/yoga/guided-yoga/' },
  { label: 'Prenatal Yoga (1:1)', href: '/yoga/prenatal/' },
  { label: 'Meditation', href: '/healing/meditation/' },
  { label: 'Sound Healing', href: '/healing/sound-healing/' },
  { label: 'Hormonal Balance', href: '/programs/hormonal-balance/' },
  { label: 'Stress Management', href: '/programs/stress-management/' },
];
const path = ['Years of teaching', 'Teachers and lineage', 'Background and training story'];
---
<BaseLayout
  jsonLd={[personSchema()]}
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }, { name: 'Meet Anupriya', path: '/about/anupriya/' }]}
>
  <article class="page">
    <!-- Hero: text on one side, full-bleed photo on the other -->
    <section class="hero">
      <div class="text">
        <Breadcrumb items={crumbs} />
        <div class="eyebrow">Meet your teacher</div>
        <h1>Anupriya</h1>
        <p class="role">Founder · 500-hour Yoga Alliance Registered Practitioner</p>
        <p class="intro">AadiVed is a women-owned studio built on a simple belief: ancient practice should feel at home in a modern life.</p>
        <div class="ctas">
          <a class="btn btn-primary" href={site.bookHref}>Book a session</a>
          <a class="btn btn-secondary" href={`tel:${site.phone.tel}`}><Icon name="phone" size={16} />Call {site.phone.display}</a>
        </div>
      </div>
      <div class="photo">
        <Image src={wide} alt="Anupriya holding a standing dancer pose by the water, her hair lifted by the wind" format="webp" width={1020} height={600} loading="eager" fetchpriority="high" />
      </div>
    </section>

    <!-- Approach: statement left, principles right -->
    <section class="wrap approach reveal" aria-labelledby="approach-h">
      <div class="lead-col">
        <div class="eyebrow">Her approach</div>
        <h2 id="approach-h">Ancient practice, at home in a modern life.</h2>
      </div>
      <ol class="principles">
        {principles.map((p, i) => (
          <li>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{p.t}</h3>
              <p>{p.p}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Who she works with -->
    <section class="wrap who reveal" aria-labelledby="who-h">
      <div class="eyebrow">Who she works with</div>
      <h2 id="who-h">Every body, every stage</h2>
      <Bento items={who} variant="a" />
      <ul class="pill-list links" aria-label="Practices">
        {practices.map((p) => <li><a class="pill" href={p.href}>{p.label}</a></li>)}
      </ul>
    </section>

    <!-- Editorial quote with the square photo -->
    <section class="quote-band reveal" aria-label="The belief behind AadiVed">
      <div class="wrap qgrid">
        <div class="qimg">
          <Image src={square} alt="Anupriya in a standing dancer pose by the water, with the words inhale and exhale beside her" format="webp" width={1080} height={1080} loading="lazy" />
        </div>
        <figure>
          <blockquote>&#8220;Ancient practice should feel at home in a modern life.&#8221;</blockquote>
          <figcaption>The belief behind AadiVed</figcaption>
        </figure>
      </div>
    </section>

    <!-- Reviews -->
    <section class="wrap kind reveal" aria-labelledby="kind-h">
      <div class="kind-head">
        <div>
          <div class="eyebrow">Kind words</div>
          <h2 id="kind-h">What students say</h2>
        </div>
        <a class="link-arrow" href={site.google.reviews}>Read all reviews on Google &#8594;</a>
      </div>
      <div class="cards">
        {reviews.map((r) => <ReviewCard review={r} />)}
      </div>
    </section>

    <!-- Her path: facts still to confirm -->
    <section class="wrap path reveal" aria-labelledby="path-h">
      <div class="eyebrow">Her path</div>
      <h2 id="path-h">The story behind the practice</h2>
      <ul class="path-grid">
        {path.map((p) => (
          <li>
            <h3>{p}</h3>
            <p>[To confirm with Anupriya]</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Credentials -->
    <section class="paper creds reveal" aria-labelledby="creds-h">
      <div class="wrap cgrid">
        <div class="ctext">
          <div class="eyebrow">Credentials</div>
          <h2 id="creds-h">500-hour Yoga Alliance Registered Practitioner</h2>
          <p>Anupriya is a 500-hour Yoga Alliance certified practitioner (RYT-500) and the founder of AadiVed Yoga and Wellness.</p>
          <ul class="facts">
            <li><span>Registration number</span> [To confirm with Anupriya]</li>
            <li><span>Year certified</span> [To confirm with Anupriya]</li>
          </ul>
        </div>
        <Certificate />
      </div>
    </section>

    <FinalCTA />
  </article>
</BaseLayout>

<style>
  .page { background: var(--ivory); }
  h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(34px, 3.8vw, 54px); line-height: 1.06; margin: 14px 0 0; }

  /* Hero */
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); min-height: min(78vh, 760px); border-bottom: 1px solid var(--line); overflow: hidden; }
  .text :global(.crumbs) { margin: 8px 0 20px; }
  .text { padding: 24px 56px 72px max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter))); display: flex; flex-direction: column; justify-content: center; }
  h1 { font-family: var(--font-display); font-weight: 400; font-size: clamp(64px, 9vw, 132px); line-height: 0.95; letter-spacing: -0.02em; margin: 18px 0 0; color: var(--ink); }
  .role { margin: 18px 0 0; font-size: 15px; letter-spacing: 0.06em; color: var(--label); }
  .intro { margin: 26px 0 0; font-size: 19px; line-height: 1.7; color: var(--text-muted); max-width: 30em; }
  .ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
  .photo { position: relative; min-height: 420px; border-top-left-radius: 220px; overflow: hidden; background: var(--sand); }
  .photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 42% 40%; display: block; }

  /* Approach */
  .approach { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 80px; padding-top: 120px; padding-bottom: 40px; align-items: start; }
  .lead-col h2 { font-size: clamp(38px, 4.4vw, 64px); max-width: 11em; }
  .principles { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .principles li { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 20px; padding: 30px 0; border-bottom: 1px solid var(--line); }
  .num { font-family: var(--font-display); font-style: italic; font-size: 64px; line-height: 0.9; color: var(--olive); }
  .principles h3 { font-family: var(--font-display); font-weight: 500; font-size: 30px; margin: 2px 0 8px; }
  .principles p { margin: 0; color: var(--text-muted); max-width: 46ch; }

  /* Who */
  .who { padding-top: 96px; padding-bottom: 40px; }
  .who h2 { margin-bottom: 32px; }
  .links { margin-top: 24px; }
  .links a:hover { background: var(--olive); color: var(--ivory); }

  /* Quote band */
  .quote-band { margin-top: 96px; background: var(--accent-soft); padding: 88px 0; }
  .qgrid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 72px; align-items: center; }
  .qimg { border-radius: 24px 24px 220px 24px; overflow: hidden; aspect-ratio: 1; background: var(--sand); box-shadow: 0 40px 70px -40px rgba(47, 52, 36, 0.5); }
  .qimg :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  figure { margin: 0; }
  blockquote { margin: 0; font-family: var(--font-display); font-style: italic; font-size: clamp(36px, 4.4vw, 62px); line-height: 1.1; color: var(--olive-deep); }
  figcaption { margin-top: 22px; font-size: 14px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--label); }

  /* Reviews */
  .kind { padding-top: 112px; padding-bottom: 24px; }
  .kind-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 40px; }

  /* Path */
  .path { padding-top: 96px; padding-bottom: 96px; }
  .path-grid { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .path-grid li { border: 1.5px dashed #BFB79F; border-radius: var(--radius-card); padding: 28px 28px 30px; }
  .path-grid h3 { font-family: var(--font-display); font-weight: 500; font-size: 28px; margin: 0; }
  .path-grid p { margin: 10px 0 0; color: var(--label); font-style: italic; }

  /* Credentials */
  .creds { padding: 104px 0; border-top: 1px solid var(--line); }
  .cgrid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 80px; align-items: center; }
  .ctext p { color: var(--text-muted); margin: 22px 0 0; max-width: 34em; }
  .facts { list-style: none; margin: 26px 0 0; padding: 0; display: grid; gap: 10px; color: var(--label); font-style: italic; }
  .facts span { display: inline-block; min-width: 10.5em; font-style: normal; font-weight: 500; color: var(--ink); }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .photo { order: -1; min-height: 0; aspect-ratio: 4 / 3; border-top-left-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
    .text { padding: 8px var(--gutter) 56px; }
    .approach, .qgrid, .cgrid { grid-template-columns: 1fr; gap: 40px; }
    .approach { padding-top: 72px; }
    .quote-band { padding: 64px 0; margin-top: 72px; }
    .qimg { max-width: 460px; }
    .cards, .path-grid { grid-template-columns: 1fr; }
    .who, .kind, .path { padding-top: 72px; }
    .creds { padding: 72px 0; }
  }
  @media (max-width: 600px) {
    .principles li { grid-template-columns: 56px minmax(0, 1fr); gap: 14px; }
    .num { font-size: 44px; }
    .ctas .btn { width: 100%; }
    .facts span { display: block; }
  }
</style>
