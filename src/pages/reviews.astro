---
import { getSeo } from '../data/seo';
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerHero from '../components/page/InnerHero.astro';
import Icon from '../components/Icon.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { site } from '../data/site';
import { reviews, rating } from '../data/reviews';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Reviews' }];
const s = getSeo(Astro.url.pathname);
---
<BaseLayout
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Reviews', path: '/reviews/' }]}
>
  <div class="page-bg">
    <InnerHero crumbs={crumbs} eyebrow="Kind words" title={s.h1} suffix={s.h1Suffix} intro="What students say about practising with AadiVed, taken from Google Reviews." />

    <section class="wrap sec score" aria-labelledby="score-h">
      <h2 id="score-h" class="sr-only">Average rating</h2>
      <div class="big" aria-label={`${rating.value} out of 5`}>{rating.value}</div>
      <div class="meta">
        <span role="img" aria-label="5 out of 5 stars" class="stars">{[0, 1, 2, 3, 4].map(() => <Icon name="star" size={22} />)}</span>
        <p>Average rating on Google Reviews<br /><span class="sub">Based on {rating.count} reviews</span></p>
      </div>
      <div class="acts">
        <a class="btn btn-primary" href={site.google.writeReview}>Leave a review</a>
        <a class="btn btn-secondary" href={site.google.reviews}>Read all reviews on Google</a>
      </div>
    </section>

    <section class="wrap list" aria-label="Reviews">
      <ul>
        {reviews.map((r, i) => (
          <li class="reveal">
            <figure>
              <span role="img" aria-label="5 out of 5 stars" class="stars sm">{[0, 1, 2, 3, 4].map(() => <Icon name="star" size={18} />)}</span>
              <blockquote>&#8220;{r.quote}&#8221;</blockquote>
              <figcaption>
                <span>Verified Google review</span>
                <a href={r.url}>View on Google &#8594;</a>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>

    <div class="gap"></div>
    <FinalCTA />
  </div>
</BaseLayout>

<style>
  .score { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 40px; align-items: center; padding-top: 72px; padding-bottom: 8px; }
  .big { font-family: var(--font-display); font-size: clamp(110px, 14vw, 200px); line-height: 0.85; color: var(--olive); }
  .meta p { margin: 8px 0 0; color: var(--text-muted); }
  .sub { font-size: 14.5px; color: var(--label); }
  .stars { display: inline-flex; gap: 3px; color: var(--star); }
  .acts { display: flex; flex-direction: column; gap: 12px; min-width: 260px; }
  .list { padding-top: 56px; }
  .list ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .list li:nth-child(1) figure { background: var(--olive); color: var(--on-dark); }
  .list li:nth-child(1) blockquote { color: var(--ivory); }
  .list li:nth-child(1) figcaption { color: var(--on-dark); }
  .list li:nth-child(1) figcaption a { color: var(--ivory); }
  .list li:nth-child(1) .stars { color: #E7C16B; }
  .list li:nth-child(2) figure { background: var(--accent-soft); }
  figure { margin: 0; padding: 44px 44px 36px; border-radius: 28px; background: var(--sand); border: 1px solid transparent; display: grid; gap: 22px; }
  .list li:nth-child(3) figure { border-color: var(--line); }
  blockquote { margin: 0; font-family: var(--font-display); font-style: italic; font-size: clamp(30px, 3.6vw, 52px); line-height: 1.15; color: var(--olive-deep); max-width: 22em; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-size: 14.5px; color: var(--label); letter-spacing: 0.03em; }
  figcaption a { font-weight: 500; display: inline-flex; align-items: center; min-height: 44px; }
  .gap { height: 96px; }
  @media (max-width: 960px) {
    .score { grid-template-columns: 1fr; gap: 20px; padding-top: 48px; }
    .acts { min-width: 0; }
    figure { padding: 32px 24px 24px; }
    .gap { height: 64px; }
  }
</style>
