---
// Generated routes. A route with detail copy in src/data/practices.ts renders the full service page,
// every other route in stubPages (src/data/site.ts) renders the "coming soon" stub.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ServicePage from '../components/page/ServicePage.astro';
import { stubPages, site } from '../data/site';
import type { StubPage } from '../data/site';
import { getPractice } from '../data/practices';
import { getSeo } from '../data/seo';
import { serviceSchema, faqSchema } from '../data/schema';

export function getStaticPaths() {
  // Routes that have their own page file
  const custom = new Set([
    'about', 'about/anupriya', 'studio', 'online-classes', 'one-on-one', 'pricing', 'classes',
    'reviews', 'journal', 'contact', 'privacy', 'terms',
  ]);
  return stubPages.filter((p) => !custom.has(p.slug)).map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: StubPage };
const practice = getPractice(page.slug);
const crumbs = [{ name: 'Home', path: '/' }];
if (page.parent) crumbs.push({ name: page.parent.label, path: page.parent.href });
crumbs.push({ name: page.title, path: `/${page.slug}/` });

const seo = getSeo(`/${page.slug}/`);
const jsonLd = practice
  ? [
      serviceSchema({
        path: `/${page.slug}/`,
        name: `${seo.h1} ${seo.h1Suffix ?? ''}`.trim(),
        serviceType: page.title,
        description: seo.description,
      }),
      faqSchema(practice.faqs),
    ]
  : [];
---
<BaseLayout breadcrumbs={crumbs} jsonLd={jsonLd}>
  {practice ? (
    <ServicePage page={page} practice={practice} />
  ) : (
    <PageHero eyebrow={page.eyebrow} title={page.title} intro={page.intro} crumb={page.parent} bookAnchor={page.slug === 'contact'} showTimings={page.showTimings} />
  )}
</BaseLayout>
