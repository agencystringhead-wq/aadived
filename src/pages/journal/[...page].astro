---
// /journal/ (page 1: the latest post featured, then a card grid) and /journal/2/, /journal/3/, ... when there are more posts.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHero from '../../components/page/InnerHero.astro';
import PostCard from '../../components/journal/PostCard.astro';
import CategoryNav from '../../components/journal/CategoryNav.astro';
import Pagination from '../../components/journal/Pagination.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { getSeo, title as seoTitle } from '../../data/seo';
import { getPublishedPosts } from '../../data/journal';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  // The latest post is featured on page 1, the rest fill the paginated grid
  return paginate(posts.slice(1), { pageSize: 9, props: { all: posts } });
}) satisfies GetStaticPaths;

const { page, all } = Astro.props;
const featured = page.currentPage === 1 ? all[0] : undefined;
const s = getSeo('/journal/');
const first = page.currentPage === 1;
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Journal' }];
const paged = first
  ? {}
  : {
      title: seoTitle(`Yoga & Wellbeing Journal, Page ${page.currentPage}`),
      description: `More articles on yoga, meditation, breathwork and wellbeing from AadiVed in Hinjawadi, Pune. Page ${page.currentPage} of the journal. Read, then book a session.`,
    };
import { linkProps } from '../../data/links';
import NewTabHint from '../../components/NewTabHint.astro';
---
<BaseLayout {...paged} breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Journal', path: '/journal/' }]}>
  <div class="page-bg">
    <InnerHero
      crumbs={crumbs}
      eyebrow="Notes and practices"
      title={first ? s.h1 : `${s.h1}, page ${page.currentPage}`}
      intro="Practical articles on yoga, meditation, breathwork and sound healing from AadiVed in Hinjawadi, Pune."
    />

    <section class="wrap sec list" aria-label="Articles">
      {all.length > 0 && <CategoryNav posts={all} />}

      {all.length === 0 && (
        <div class="empty">
          <span class="ico" aria-hidden="true"><Icon name="leaf" size={30} stroke={1.4} /></span>
          <h2>The journal is on its way</h2>
          <p>We are writing our first articles. Until then, follow along on Instagram or explore the classes.</p>
          <div class="row">
            <a class="btn btn-primary" href={site.instagram.url} {...linkProps(site.instagram.url)}>Follow {site.instagram.handle}<NewTabHint href={site.instagram.url} /></a>
            <a class="btn btn-secondary" href="/classes/">Explore classes</a>
          </div>
        </div>
      )}

      {featured && (
        <div class="feat"><PostCard post={featured} featured /></div>
      )}

      {page.data.length > 0 && (
        <ul class="grid">
          {page.data.map((p) => <li><PostCard post={p} /></li>)}
        </ul>
      )}

      <Pagination current={page.currentPage} last={page.lastPage} />
    </section>

    <FinalCTA />
  </div>
</BaseLayout>

<style>
  .list { padding-top: 56px; padding-bottom: 96px; }
  .feat { margin-top: 32px; }
  .grid { list-style: none; margin: 24px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .grid li { min-width: 0; }
  .empty { margin-top: 24px; border-radius: 28px; padding: 64px 48px; background: var(--accent-soft); display: grid; gap: 14px; justify-items: start; max-width: 860px; }
  .ico { width: 64px; height: 64px; border-radius: 50%; background: var(--olive); color: var(--ivory); display: inline-flex; align-items: center; justify-content: center; }
  .empty h2 { font-family: var(--font-display); font-weight: 500; font-size: clamp(34px, 4vw, 52px); line-height: 1.08; margin: 8px 0 0; }
  .empty p { margin: 0; color: var(--text-muted); max-width: 40em; }
  .row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; }
  @media (max-width: 960px) {
    .list { padding-top: 40px; padding-bottom: 64px; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .empty { padding: 40px 24px; }
  }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
