---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHero from '../../components/page/InnerHero.astro';
import Icon from '../../components/Icon.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { site } from '../../data/site';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Journal' }];
const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout
  title="Journal | AadiVed Yoga and Wellness"
  description="Notes and simple practices from the AadiVed studio in Hinjawadi, Pune."
  breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Journal', path: '/journal/' }]}
>
  <div class="page-bg">
    <InnerHero crumbs={crumbs} eyebrow="Notes and practices" title="The journal" intro="Simple practices and notes from the studio." />

    <section class="wrap sec last" aria-labelledby="posts-h">
      <h2 id="posts-h" class="sr-only">Posts</h2>
      {posts.length === 0 ? (
        <div class="empty">
          <span class="ico" aria-hidden="true"><Icon name="leaf" size={30} stroke={1.4} /></span>
          <h3>The journal is on its way</h3>
          <p>We are writing our first notes and simple practices to try at home. Until then, follow along on Instagram or explore the classes.</p>
          <div class="row">
            <a class="btn btn-primary" href={site.instagram.url}>Follow {site.instagram.handle}</a>
            <a class="btn btn-secondary" href="/classes/">Explore classes</a>
          </div>
        </div>
      ) : (
        <ul class="posts">
          {posts.map((p) => (
            <li class="reveal">
              <a href={`/journal/${p.id}/`}>
                {p.data.cover && <span class="pic"><Image src={p.data.cover} alt={p.data.coverAlt ?? ''} format="webp" width={640} height={400} loading="lazy" /></span>}
                <span class="meta"><span class="pill">{p.data.category}</span> <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time></span>
                <span class="t">{p.data.title}</span>
                <span class="d">{p.data.description}</span>
                <span class="go">Read more &#8594;</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    <FinalCTA />
  </div>
</BaseLayout>

<style>
  .last { padding-bottom: 96px; padding-top: 72px; }
  .empty { border-radius: 28px; padding: 64px 48px; background: var(--accent-soft); display: grid; gap: 14px; justify-items: start; max-width: 860px; }
  .ico { width: 64px; height: 64px; border-radius: 50%; background: var(--olive); color: var(--ivory); display: inline-flex; align-items: center; justify-content: center; }
  h3 { font-family: var(--font-display); font-weight: 500; font-size: clamp(34px, 4vw, 52px); line-height: 1.08; margin: 8px 0 0; }
  .empty p { margin: 0; color: var(--text-muted); max-width: 40em; }
  .row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; }
  .posts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .posts a { display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 0 0 26px; border-radius: var(--radius-card); background: var(--sand); border: 1px solid var(--line); overflow: hidden; color: var(--ink); }
  .posts a > *:not(.pic) { margin-inline: 24px; }
  .pic { display: block; aspect-ratio: 8 / 5; overflow: hidden; }
  .pic :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 20px; font-size: 14px; color: var(--label); }
  .posts a:not(:has(.pic)) .meta { margin-top: 24px; }
  .t { font-family: var(--font-display); font-weight: 500; font-size: 28px; line-height: 1.1; }
  .d { font-size: 15.5px; color: var(--text-muted); flex-grow: 1; }
  .go { font-size: 14.5px; font-weight: 500; color: var(--olive); }
  @media (max-width: 960px) { .last { padding-bottom: 64px; padding-top: 48px; } .posts { grid-template-columns: 1fr; } .empty { padding: 40px 24px; } }
</style>
