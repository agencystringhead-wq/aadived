---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';
// Free stock photos (Pexels). Credits in design-source/stock-credits.md
// TODO: replace formats-studio.webp with a real photo of the studio (Megapolis Serenity) when the client sends one
import studio from '../assets/images/stock/formats-studio.webp';
import online from '../assets/images/stock/formats-online.webp';
---
<section class="formats">
  <div class="wrap section">
    <SectionHeading center eyebrow="Practice your way" title="In the studio, or from your own mat" />
    <div class="grid">
      <div class="card studio">
        <div class="photo">
          <Image src={studio} alt="Rolled grey yoga mats and a stack of folded striped blankets on a wooden shelf, with bolsters underneath"
            format="webp" width={700} height={350} densities={[1, 2]} loading="lazy" />
        </div>
        <div class="body">
          <h3>Studio sessions</h3>
          <p>Small, unhurried classes at Megapolis Serenity in Hinjawadi Phase 3. Personal attention on every asana, with sound healing in a quiet, grounded space.</p>
          <a class="link-arrow" href={site.google.directions}>Get directions &#8594;</a>
        </div>
      </div>
      <div class="card online">
        <div class="photo">
          <Image src={online} alt="Overhead view of a person in child pose on a jute rug beside a bed, with a laptop on the wooden floor next to them"
            format="webp" width={700} height={350} densities={[1, 2]} loading="lazy" />
        </div>
        <div class="body">
          <h3>Live online sessions</h3>
          <p>The same guided practice, wherever you are. Live classes with real-time cues and corrections, for beginners and experienced yogis alike.</p>
          <a class="link-arrow" href="/online-classes/">See online schedule &#8594;</a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .formats { background: var(--sand); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); gap: 28px; margin-top: 60px; }
  .card { border-radius: 26px; overflow: hidden; display: flex; flex-direction: column; }
  .studio { background: var(--ivory); }
  .online { background: var(--olive); color: var(--sand); }
  .photo { aspect-ratio: 2 / 1; overflow: hidden; background: var(--sand); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .body { padding: 36px 38px 40px; }
  h3 { font-family: var(--font-display); font-weight: 500; font-size: 34px; margin: 0; }
  p { margin: 12px 0 0; color: var(--text-muted); }
  .online p { color: var(--on-dark); }
  .link-arrow { margin-top: 22px; }
  .online .link-arrow { color: var(--ivory); border-bottom-color: var(--ivory); }
  @media (max-width: 480px) { .body { padding: 28px 24px 32px; } }
</style>
