---
// Large numbered steps, editorial style.
interface Props {
  steps: { title: string; text: string }[];
}
const { steps } = Astro.props;
---
<ol class="steps">
  {steps.map((s, i) => (
    <li>
      <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <div>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </div>
    </li>
  ))}
</ol>
<style>
  .steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .steps li { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 24px; padding: 30px 0; border-bottom: 1px solid var(--line); align-items: start; }
  .num { font-family: var(--font-display); font-style: italic; font-size: 84px; line-height: 0.9; color: var(--olive); }
  h3 { font-family: var(--font-display); font-weight: 500; font-size: 30px; margin: 4px 0 8px; }
  p { margin: 0; color: var(--text-muted); max-width: 52ch; }
  @media (max-width: 600px) {
    .steps li { grid-template-columns: 64px minmax(0, 1fr); gap: 14px; }
    .num { font-size: 52px; }
    h3 { font-size: 26px; }
  }
</style>
