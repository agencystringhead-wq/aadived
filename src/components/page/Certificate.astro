---
// Framed certificate card with a click-to-enlarge lightbox.
// TODO: drop the real certificate scan at src/assets/images/certificates/ryt-500.webp.
// Until the file exists the frame shows a placeholder and no lightbox is rendered.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const found = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/certificates/ryt-500.webp', { eager: true });
const cert = Object.values(found)[0]?.default;
const alt = 'Yoga Alliance RYT-500 certificate for Anupriya';
---
<div class="cert">
  {cert ? (
    <>
      <button type="button" class="frame" data-cert-open aria-haspopup="dialog" aria-label="Enlarge the Yoga Alliance RYT-500 certificate">
        <Image src={cert} alt={alt} format="webp" width={720} loading="lazy" />
        <span class="hint">Click to enlarge</span>
      </button>
      <dialog class="lightbox" data-cert-dialog aria-label="Yoga Alliance RYT-500 certificate">
        <button type="button" class="close" data-cert-close aria-label="Close">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
        <Image src={cert} alt={alt} format="webp" width={1600} loading="lazy" />
      </dialog>
    </>
  ) : (
    <div class="frame placeholder" role="img" aria-label="Certificate image coming soon">
      <span>Yoga Alliance RYT-500 certificate · image coming soon</span>
    </div>
  )}
</div>

<style>
  .cert { perspective: 1200px; }
  .frame { position: relative; display: block; width: 100%; padding: 22px; background: #fffdf8; border: 1px solid var(--line); border-radius: 6px; box-shadow: 0 30px 60px -28px rgba(47, 52, 36, 0.45), 0 2px 0 rgba(255, 255, 255, 0.8) inset; transform: rotate(-1.6deg); transition: transform .45s ease, box-shadow .45s ease; font: inherit; color: inherit; text-align: left; }
  button.frame { cursor: zoom-in; }
  .frame::before { content: ''; position: absolute; inset: 10px; border: 1px solid #E8DFC9; border-radius: 3px; pointer-events: none; }
  .frame:hover, .frame:focus-visible { transform: rotate(0deg); box-shadow: 0 36px 70px -28px rgba(47, 52, 36, 0.5); }
  .frame :global(img) { display: block; width: 100%; height: auto; }
  .hint { position: absolute; right: 30px; bottom: 30px; padding: 6px 14px; border-radius: var(--radius-pill); background: rgba(47, 52, 36, 0.86); color: var(--ivory); font-size: 13px; letter-spacing: 0.04em; opacity: 0; transition: opacity .25s; }
  .frame:hover .hint, .frame:focus-visible .hint { opacity: 1; }
  .placeholder { aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center; text-align: center; padding: 40px; background: repeating-linear-gradient(135deg, #fffdf8, #fffdf8 14px, #faf5ea 14px, #faf5ea 28px); }
  .placeholder span { font-family: var(--font-display); font-style: italic; font-size: 26px; line-height: 1.25; color: var(--label); max-width: 16em; }

  .lightbox { border: 0; padding: 14px; background: #fffdf8; border-radius: 10px; max-width: min(1100px, 94vw); max-height: 92vh; overflow: auto; box-shadow: 0 40px 100px rgba(0, 0, 0, 0.5); }
  .lightbox::backdrop { background: rgba(35, 38, 28, 0.78); }
  .lightbox :global(img) { display: block; width: 100%; height: auto; max-height: calc(92vh - 28px); object-fit: contain; }
  .close { position: absolute; top: 12px; right: 12px; z-index: 1; width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--line); background: var(--ivory); color: var(--olive-deep); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }

  @media (prefers-reduced-motion: reduce) {
    .frame, .hint { transition: none; }
  }
  @media (max-width: 600px) { .frame { padding: 14px; } .placeholder span { font-size: 22px; } }
</style>

<script>
  // Native modal <dialog>: focus is trapped inside, Esc closes it, and focus returns to the trigger.
  (() => {
    const open = document.querySelector<HTMLButtonElement>('[data-cert-open]');
    const dialog = document.querySelector<HTMLDialogElement>('[data-cert-dialog]');
    if (!open || !dialog) return;
    open.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-cert-close]')?.addEventListener('click', () => dialog.close());
    // Click on the backdrop (outside the dialog box) closes it
    dialog.addEventListener('click', (e) => {
      const r = dialog.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!inside) dialog.close();
    });
  })();
</script>
