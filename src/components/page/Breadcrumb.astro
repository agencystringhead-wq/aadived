---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((it, i) => (
      <li>
        {it.href && i < items.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; list-style: none; margin: 0; padding: 0; font-size: 14.5px; color: var(--label); }
  .crumbs li { display: inline-flex; align-items: center; min-height: 44px; }
  .crumbs li + li::before { content: '/'; margin-right: 10px; color: #A9AC96; }
  .crumbs a { color: var(--label); border-bottom: 1px solid transparent; }
  .crumbs a:hover { color: var(--olive-deep); border-bottom-color: currentColor; }
  .crumbs [aria-current] { color: var(--olive-deep); font-weight: 500; }
</style>
