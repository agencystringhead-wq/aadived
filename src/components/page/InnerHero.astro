---
// Editorial hero for the inner pages.
// variant "plain": big headline left, intro right. "arch": headline left, arch image right.
// variant "wide": headline and intro, then a wide image underneath.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumb from './Breadcrumb.astro';

interface Props {
  crumbs: { label: string; href?: string }[];
  eyebrow: string;
  title: string;
  intro?: string;
  variant?: 'plain' | 'arch' | 'wide';
  image?: ImageMetadata;
  imageAlt?: string;
}
const { crumbs, eyebrow, title, intro, variant = 'plain', image, imageAlt = '' } = Astro.props;
const hasImage = Boolean(image) && variant !== 'plain';
---
<section class:list={['hero', `v-${variant}`]}>
  <div class="wrap"><Breadcrumb items={crumbs} /></div>
  <div class="wrap grid">
    <div class="copy">
      <div class="eyebrow">{eyebrow}</div>
      <h1>{title}</h1>
      {intro && <p class="intro">{intro}</p>}
      <div class="extra"><slot /></div>
    </div>
    {hasImage && variant === 'arch' && (
      <div class="visual">
        <div class="circle" aria-hidden="true"></div>
        <div class="arch"><Image src={image!} alt={imageAlt} format="webp" width={480} height={600} densities={[1, 2]} loading="eager" fetchpriority="high" /></div>
      </div>
    )}
  </div>
  {hasImage && variant === 'wide' && (
    <div class="wrap wide">
      <div class="frame"><Image src={image!} alt={imageAlt} format="webp" width={1240} loading="eager" fetchpriority="high" /></div>
    </div>
  )}
</section>
<style>
  .hero { border-bottom: 1px solid var(--line); overflow: hidden; }
  .hero > .wrap:first-child { padding-top: 16px; }
  .grid { display: grid; gap: 56px; padding-top: 8px; padding-bottom: 72px; align-items: center; }
  .v-plain .grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; }
  .v-arch .grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); padding-bottom: 88px; }
  .v-wide .grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; padding-bottom: 48px; }
  h1 { font-family: var(--font-display); font-weight: 400; font-size: clamp(52px, 7vw, 104px); line-height: 0.98; letter-spacing: -0.015em; margin: 16px 0 0; color: var(--ink); }
  .v-plain .copy, .v-wide .copy { display: contents; }
  .v-plain .eyebrow, .v-wide .eyebrow { grid-column: 1 / -1; margin-bottom: -40px; }
  .v-plain h1, .v-wide h1 { grid-column: 1; }
  .intro { font-size: 20px; line-height: 1.65; color: var(--text-muted); max-width: 560px; margin: 28px 0 0; }
  .v-plain .intro, .v-wide .intro { grid-column: 2; margin: 0; padding-bottom: 10px; }
  .extra { margin-top: 28px; }
  .extra:empty { display: none; }
  .v-plain .extra, .v-wide .extra { grid-column: 1 / -1; margin-top: 0; }

  .visual { position: relative; display: flex; justify-content: center; padding: 20px 0 20px; }
  .circle { position: absolute; width: 360px; height: 360px; border-radius: 50%; background: var(--accent); opacity: 0.55; top: 10px; left: -30px; }
  .arch { position: relative; width: 100%; max-width: 400px; aspect-ratio: 4 / 5; border-radius: 220px 220px 24px 24px; overflow: hidden; background: var(--sand); }
  .arch :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }

  .wide { padding-bottom: 72px; }
  .frame { border-radius: 24px 24px 24px 220px; overflow: hidden; aspect-ratio: 16 / 10; background: var(--sand); }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 55%; display: block; }

  @media (max-width: 960px) {
    .grid, .v-plain .grid, .v-arch .grid, .v-wide .grid { grid-template-columns: 1fr; gap: 24px; padding-bottom: 48px; }
    .v-plain .copy, .v-wide .copy { display: block; }
    .v-plain .eyebrow, .v-wide .eyebrow { margin-bottom: 0; }
    .v-plain .intro, .v-wide .intro { margin-top: 24px; }
    .visual { order: -1; padding: 8px 0 28px; }
    .arch { max-width: 320px; }
    .circle { width: 260px; height: 260px; left: 4%; }
    .wide { padding-bottom: 48px; }
    .frame { aspect-ratio: 4 / 3; border-bottom-left-radius: 120px; }
  }
  @media (max-width: 600px) { .intro { font-size: 18px; } }
</style>
