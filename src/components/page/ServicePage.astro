---
// Editorial service page, driven by src/data/practices.ts.
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import FinalCTA from '../FinalCTA.astro';
import Breadcrumb from './Breadcrumb.astro';
import Bento from './Bento.astro';
import Faq from './Faq.astro';
import BookCard from './BookCard.astro';
import { site, stubPages, type StubPage } from '../../data/site';
import { formatLabels, type Practice } from '../../data/practices';
import { reviews } from '../../data/reviews';

interface Props {
  page: StubPage;
  practice: Practice;
}
const { page, practice } = Astro.props;
const review = reviews[practice.reviewIndex] ?? reviews[0];
const related = practice.related
  .map((slug) => stubPages.find((p) => p.slug === slug))
  .filter((p): p is StubPage => Boolean(p));
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'All classes', href: '/classes/' },
  { label: page.title },
];
---
<article class="service">
  <section class="hero">
    <div class="wrap"><Breadcrumb items={crumbs} /></div>
    <div class="wrap hero-grid">
      <div class="copy">
        <ul class="pill-list tags">
          <li class="pill pill-lav">{practice.category}</li>
          {practice.formats.map((f) => <li class="pill">{formatLabels[f]}</li>)}
        </ul>
        <h1>{page.title}</h1>
        <p class="intro">{practice.intro}</p>
        <div class="ctas">
          <a class="btn btn-primary" href={site.bookHref}>Book a session</a>
          <a class="btn btn-secondary" href={`tel:${site.phone.tel}`}><Icon name="phone" size={16} />Call {site.phone.display}</a>
        </div>
      </div>
      <div class="visual">
        <div class="circle" aria-hidden="true"></div>
        <div class="arch">
          <Image src={practice.image} alt={practice.imageAlt} format="webp" width={480} height={600} densities={[1, 2]} loading="eager" fetchpriority="high" />
        </div>
        <p class="chip"><Icon name="pin" size={15} />{site.timings.daysShort} · {site.timings.time}</p>
      </div>
    </div>
  </section>

  <div class="wrap layout">
    <div class="main">
      <section class="block reveal" aria-labelledby="what-h">
        <div class="eyebrow">What it is</div>
        <h2 id="what-h" class="sr-only">What it is</h2>
        <p class="lead">{practice.what[0]}</p>
        {practice.what.slice(1).map((p) => <p class="body">{p}</p>)}
      </section>

      <section class="block reveal" aria-labelledby="who-h">
        <div class="eyebrow">Who it is for</div>
        <h2 id="who-h">Made for how you live now</h2>
        <Bento items={practice.who} variant="a" />
      </section>

      <section class="block reveal" aria-labelledby="session-h">
        <div class="eyebrow">What a session looks like</div>
        <h2 id="session-h">Three quiet stages</h2>
        <ol class="steps">
          {practice.steps.map((s, i) => (
            <li>
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="block reveal" aria-labelledby="help-h">
        <div class="eyebrow">How it can help</div>
        <h2 id="help-h">What it can support</h2>
        <Bento items={practice.help} variant="b" />
      </section>

      <section class="block reveal" aria-labelledby="join-h">
        <div class="eyebrow">Ways to join</div>
        <h2 id="join-h">Where to practise</h2>
        <ul class="pill-list join">
          {practice.formats.map((f) => <li class="pill pill-olive">{formatLabels[f]}</li>)}
        </ul>
        <p class="body">Classes run {site.timings.days}, {site.timings.time}, at Megapolis Serenity in Hinjawadi Phase 3. See <a href="/pricing/">plans and pricing</a> or <a href={site.bookHref}>book a session</a>.</p>
      </section>

      <section class="block reveal" aria-labelledby="faq-h">
        <div class="eyebrow">Questions</div>
        <h2 id="faq-h">Good to know</h2>
        <Faq items={practice.faqs} />
        {practice.prenatalNote && <p class="note">Please consult your doctor before starting any prenatal practice.</p>}
        <p class="note">This practice supports wellbeing and is not medical advice. Talk to your doctor about any health concern.</p>
      </section>

      <section class="block reveal quote" aria-label="Review">
        <span role="img" aria-label="5 out of 5 stars" class="stars">{[0, 1, 2, 3, 4].map(() => <Icon name="star" size={18} />)}</span>
        <blockquote>&#8220;{review.quote}&#8221;</blockquote>
        <p class="cite">Verified Google review · <a href={review.url}>View on Google &#8594;</a></p>
      </section>

      {related.length > 0 && (
        <section class="block reveal" aria-labelledby="rel-h">
          <div class="eyebrow">Related practices</div>
          <h2 id="rel-h">Continue with</h2>
          <ul class="related">
            {related.map((r) => (
              <li>
                <a href={`/${r.slug}/`}>
                  <span class="pill">{r.eyebrow}</span>
                  <span class="rt">{r.title}</span>
                  <span class="rp">{r.intro}</span>
                  <span class="go">Learn more &#8594;</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <BookCard title={page.title} formats={practice.formats} />
  </div>

  <FinalCTA />
</article>

<style>
  .service { background: var(--ivory); }

  /* Hero: asymmetric, text left, arch image offset right */
  .hero { overflow: hidden; border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: 56px; align-items: center; padding-top: 8px; padding-bottom: 88px; }
  .hero > .wrap:first-child { padding-top: 16px; }
  .tags { margin: 0 0 26px; }
  h1 { font-family: var(--font-display); font-weight: 400; font-size: clamp(52px, 7vw, 104px); line-height: 0.98; letter-spacing: -0.015em; margin: 0; color: var(--ink); }
  .intro { font-size: 20px; line-height: 1.65; color: var(--text-muted); max-width: 560px; margin: 28px 0 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px; }
  .visual { position: relative; display: flex; justify-content: center; padding: 20px 0 36px; }
  .circle { position: absolute; width: 360px; height: 360px; border-radius: 50%; background: var(--accent); opacity: 0.55; top: 10px; left: -30px; }
  .arch { position: relative; width: 100%; max-width: 400px; aspect-ratio: 4 / 5; border-radius: 220px 220px 24px 24px; overflow: hidden; background: var(--sand); }
  .arch :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .chip { position: absolute; left: 8%; bottom: 8px; margin: 0; display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: var(--radius-pill); background: var(--ivory); border: 1px solid var(--line); box-shadow: 0 16px 30px -20px rgba(47, 52, 36, 0.5); font-size: 14px; font-weight: 500; color: var(--olive-deep); }

  /* Body: main column + sticky card */
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 72px; align-items: start; padding-top: 24px; }
  .block { padding: 72px 0 8px; }
  .block h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(34px, 3.6vw, 50px); line-height: 1.06; margin: 14px 0 32px; }
  .lead { font-family: var(--font-display); font-size: clamp(28px, 2.8vw, 38px); line-height: 1.25; color: var(--olive-deep); margin: 18px 0 0; max-width: 24em; }
  .body { color: var(--text-muted); margin: 22px 0 0; max-width: 62ch; }
  .body a, .note a, .cite a { border-bottom: 1px solid currentColor; }

  .steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .steps li { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 24px; padding: 30px 0; border-bottom: 1px solid var(--line); align-items: start; }
  .num { font-family: var(--font-display); font-style: italic; font-size: 84px; line-height: 0.9; color: var(--olive); }
  .steps h3 { font-family: var(--font-display); font-weight: 500; font-size: 30px; margin: 4px 0 8px; }
  .steps p { margin: 0; color: var(--text-muted); max-width: 52ch; }

  .join { margin-bottom: 8px; }
  .note { margin: 22px 0 0; font-size: 14.5px; color: var(--label); max-width: 62ch; }

  .quote { margin-top: 48px; padding: 44px 40px 40px; border-radius: 28px; background: var(--accent-soft); }
  .stars { display: inline-flex; gap: 3px; color: var(--star); }
  blockquote { margin: 18px 0 0; font-family: var(--font-display); font-style: italic; font-size: clamp(30px, 3vw, 42px); line-height: 1.2; color: var(--olive-deep); max-width: 22em; }
  .cite { margin: 18px 0 0; font-size: 14.5px; color: var(--label); }

  .related { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .related a { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; height: 100%; padding: 24px; border-radius: var(--radius-card); background: var(--sand); border: 1px solid var(--line); color: var(--ink); transition: transform .3s; }
  .related a:hover { transform: translateY(-3px); color: var(--ink); }
  .rt { font-family: var(--font-display); font-weight: 500; font-size: 26px; line-height: 1.12; }
  .rp { font-size: 15px; color: var(--text-muted); flex-grow: 1; }
  .go { font-size: 14.5px; font-weight: 500; color: var(--olive); }
  .block:last-child { padding-bottom: 88px; }
  @media (prefers-reduced-motion: reduce) { .related a { transition: none; } }

  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; gap: 24px; padding-bottom: 56px; }
    .visual { order: -1; padding: 8px 0 28px; }
    .arch { max-width: 320px; }
    .circle { width: 260px; height: 260px; left: 4%; }
    .layout { grid-template-columns: 1fr; gap: 0; }
    .block { padding-top: 56px; }
    .related { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .intro { font-size: 18px; }
    .steps li { grid-template-columns: 64px minmax(0, 1fr); gap: 14px; }
    .num { font-size: 52px; }
    .steps h3 { font-size: 26px; }
    .quote { padding: 32px 24px; }
    .ctas .btn { width: 100%; }
  }
</style>
