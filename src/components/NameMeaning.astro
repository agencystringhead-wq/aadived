---
---
<section class="name">
  <div class="wrap inner section">
    <div class="words" aria-label="Aadi means beginning, Ved means knowledge">
      <div>
        <div class="deva" lang="hi">आदि</div>
        <div class="eyebrow cap">Aadi · Beginning</div>
      </div>
      <div class="plus" aria-hidden="true">+</div>
      <div>
        <div class="deva" lang="hi">वेद</div>
        <div class="eyebrow cap">Ved · Knowledge</div>
      </div>
    </div>
    <div class="text">
      <div class="eyebrow">Our name, our way</div>
      <h2>Deeply rooted. Gently guided.</h2>
      <p>AadiVed brings mindful movement, breath and being into everyday life. Every class blends asana, breathwork and grounding practices so the calm carries off the mat and into your day.</p>
      <a class="link-arrow" href="/about/">Read our story &#8594;</a>
    </div>
  </div>
</section>
<script>
  // The Devanagari font is ~100KB and sits below the fold: fetch it only when the section is near the viewport.
  const words = document.querySelector('.words');
  const ready = () => document.documentElement.classList.add('deva-ready');
  if (words && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { ready(); io.disconnect(); }
    }, { rootMargin: '800px 0px' });
    io.observe(words);
  } else {
    ready();
  }
</script>
<style is:global>
  html.deva-ready .deva { font-family: var(--font-deva); }
</style>
<style>
  .name { background: var(--sand); }
  .inner { display: flex; flex-wrap: wrap; gap: 72px; align-items: center; }
  .words { flex: 1 1 460px; min-width: 0; display: flex; gap: 28px; align-items: flex-end; flex-wrap: wrap; }
  .deva { font-family: serif; font-size: 120px; line-height: 1; color: var(--olive); }
  .cap { margin-top: 14px; }
  .plus { font-family: var(--font-display); font-size: 72px; line-height: 1; color: #8A8C77; padding-bottom: 44px; }
  .text { flex: 1 1 440px; min-width: 0; }
  h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(36px, 4vw, 54px); line-height: 1.1; margin: 16px 0 0; }
  p { color: var(--text-muted); margin: 22px 0 0; }
  .link-arrow { margin-top: 26px; }
  @media (max-width: 768px) { .inner { gap: 40px; } .deva { font-size: 88px; } .plus { font-size: 56px; padding-bottom: 32px; } }
</style>
