---
// Cookie consent for Google Analytics. Analytics is OFF until the visitor accepts.
// The choice lives in window.aadivedConsent (defined by the inline script in BaseLayout) and in localStorage.
// "Cookie settings" in the footer (any element with data-cookie-settings) reopens this banner.
---
<div class="cookie" id="cookie-banner" role="dialog" aria-modal="false" aria-labelledby="cookie-h" aria-describedby="cookie-d" hidden>
  <h2 id="cookie-h">Cookies and analytics</h2>
  <p id="cookie-d">We would like to use Google Analytics cookies to see how this website is used, so we can improve it. Nothing is switched on unless you accept. <a href="/privacy/#cookies">How it works</a></p>
  <div class="btns">
    <button type="button" class="btn btn-primary" data-cookie-accept>Accept analytics</button>
    <button type="button" class="btn btn-secondary" data-cookie-decline>Decline</button>
  </div>
</div>

<style>
  .cookie { position: fixed; left: 16px; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 80; max-width: 560px; margin: 0; padding: 22px 24px 20px; background: var(--ivory); color: var(--ink); border: 1px solid var(--line); border-radius: 22px; box-shadow: 0 24px 60px -20px rgba(35, 38, 28, 0.45); display: grid; gap: 10px; }
  .cookie[hidden] { display: none; }
  h2 { font-family: var(--font-display); font-weight: 500; font-size: 26px; line-height: 1.1; margin: 0; color: var(--olive-deep); }
  p { margin: 0; font-size: 15.5px; line-height: 1.55; color: var(--text-muted); }
  p a { color: var(--olive); border-bottom: 1px solid currentColor; }
  .btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .btns .btn { flex: 1 1 160px; min-height: 48px; }
  @media (min-width: 700px) { .cookie { left: 24px; right: auto; bottom: 24px; } }
</style>

<script>
  (() => {
    const w = window as any;
    const banner = document.getElementById('cookie-banner');
    const consent = w.aadivedConsent;
    if (!banner || !consent) return;
    const show = (focus: boolean) => {
      banner.hidden = false;
      if (focus) banner.querySelector<HTMLElement>('[data-cookie-accept]')?.focus();
    };
    const hide = () => { banner.hidden = true; };

    if (consent.get() === null) show(false);

    banner.querySelector('[data-cookie-accept]')?.addEventListener('click', () => { consent.accept(); hide(); });
    banner.querySelector('[data-cookie-decline]')?.addEventListener('click', () => { consent.decline(); hide(); });
    document.addEventListener('click', (e) => {
      if ((e.target as Element | null)?.closest?.('[data-cookie-settings]')) show(true);
    });
  })();
</script>
