---
// Previous and next links with page numbers. Renders nothing when there is only one page.
interface Props {
  current: number;
  last: number;
  base?: string; // "/journal/" so page 2 is /journal/2/
}
const { current, last, base = '/journal/' } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}${n}/`);
const pages = Array.from({ length: last }, (_, i) => i + 1);
---
{last > 1 && (
  <nav class="pager" aria-label="Pagination">
    {current > 1 ? <a class="btn btn-secondary" href={href(current - 1)} rel="prev">&#8592; Newer</a> : <span class="ghost">&#8592; Newer</span>}
    <ol>
      {pages.map((n) => (
        <li><a href={href(n)} aria-current={n === current ? 'page' : undefined} class:list={{ on: n === current }}>{n}</a></li>
      ))}
    </ol>
    {current < last ? <a class="btn btn-secondary" href={href(current + 1)} rel="next">Older &#8594;</a> : <span class="ghost">Older &#8594;</span>}
  </nav>
)}
<style>
  .pager { display: flex; align-items: center; justify-content: center; gap: 18px; margin-top: 56px; flex-wrap: wrap; }
  ol { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0; }
  ol a { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; border-radius: 50%; border: 1px solid var(--line); color: var(--olive-deep); font-weight: 500; }
  ol a.on { background: var(--olive); border-color: var(--olive); color: var(--ivory); }
  .ghost { color: #A9AC96; padding: 0 12px; }
</style>
