---
// A calm callout for health notes and tips.
interface Props {
  title?: string;
}
const { title } = Astro.props;
---
<aside class="note" role="note">
  {title && <strong>{title}</strong>}
  <div class="body"><slot /></div>
</aside>
<style>
  .note { margin: 36px 0; padding: 22px 26px; border-radius: 18px; background: var(--accent-soft); color: var(--olive-deep); }
  .note strong { display: block; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 500; margin-bottom: 8px; color: var(--label); }
  .note .body :global(p) { margin: 0; font-size: 16.5px; line-height: 1.65; color: var(--olive-deep); max-width: none; }
  .note .body :global(p + p) { margin-top: 10px; }
</style>
