---
import { aboutLinks, aboutQuote } from '../data/site';
---
<div class="panel about" id="panel-about" hidden>
  <div class="wrap grid">
    <div>
      {aboutLinks.map((l) => <a class="mm-link" href={l.href}>{l.label}</a>)}
    </div>
    <p class="quote">{aboutQuote}</p>
  </div>
</div>
<style>
  .grid { padding-top: 36px; padding-bottom: 40px; display: grid; grid-template-columns: minmax(220px, 1fr) minmax(0, 2fr); gap: 40px; }
  .mm-link { padding: 0; display: flex; align-items: center; color: var(--olive-deep); font-size: 16px; min-height: 44px; line-height: 1.4; }
  .mm-link:hover { color: var(--olive); text-decoration: underline; text-underline-offset: 4px; }
  .quote { font-family: var(--font-display); font-size: 26px; line-height: 1.3; color: var(--olive-deep); font-style: italic; max-width: 560px; }
</style>
