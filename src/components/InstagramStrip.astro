---
import { Image } from 'astro:assets';
import { site } from '../data/site';
// TODO: replace with original high-res photos (all four ig-*.webp files are low-res Instagram crops)
import guided from '../assets/images/ig-guided.webp';
import sanskrit from '../assets/images/ig-sanskrit.webp';
import mono from '../assets/images/ig-mono.webp';
import yogaday from '../assets/images/ig-yogaday.webp';
const tiles = [
  { src: guided, alt: 'Instagram post: Guided Yoga and Meditation for everyday well-being' },
  { src: sanskrit, alt: 'Instagram post: In Sanskrit, Aadi means beginning and Ved means knowledge' },
  { src: mono, alt: 'Instagram post: AadiVed logo, Mind. Body. Soul' },
  { src: yogaday, alt: 'Instagram post: a woman holding a dancer pose outdoors', crop: true },
];
import { linkProps } from '../data/links';
import NewTabHint from '../components/NewTabHint.astro';
---
<section class="insta">
  <div class="wrap block">
    <div class="head">
      <div>
        <div class="eyebrow">On the mat this week</div>
        <h2>{site.instagram.handle}</h2>
      </div>
      <a class="btn btn-secondary" href={site.instagram.url} {...linkProps(site.instagram.url)}>Follow on Instagram<NewTabHint href={site.instagram.url} /></a>
    </div>
    <div class="grid">
      {tiles.map((t) => (
        <a class:list={["tile", { crop: t.crop }]} href={site.instagram.url} {...linkProps(site.instagram.url)}>
          <Image src={t.src} alt={t.alt} format="webp" width={300} height={400} loading="lazy" />
        <NewTabHint href={site.instagram.url} /></a>
      ))}
    </div>
  </div>
</section>
<style>
  .insta { background: var(--sand); }
  .block { padding-top: 110px; padding-bottom: 110px; }
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; }
  h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(36px, 4vw, 56px); line-height: 1.08; margin: 16px 0 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 18px; margin-top: 48px; }
  /* Low-res Instagram crops: never display wider than ~300px */
  .tile { display: block; aspect-ratio: 3 / 4; border-radius: 16px; overflow: hidden; width: 100%; max-width: 300px; justify-self: center; }
  .tile.crop :global(img) { transform: scale(1.35); transform-origin: 50% 100%; }
  .tile :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 768px) { .block { padding-top: 72px; padding-bottom: 72px; } .grid { grid-template-columns: repeat(2, 1fr); } }
</style>
