---
import Icon from './Icon.astro';
import type { Service } from '../data/services';
const { service } = Astro.props as { service: Service };
---
<a class="card" href={service.href}>
  <div class="badge" style={`background:${service.bg}`}><Icon d={service.icon} size={28} stroke={1.4} /></div>
  <h3>{service.title}</h3>
  <p>{service.text}</p>
  <span class="more">Learn more &#8594;</span>
</a>
<style>
  .card { display: flex; flex-direction: column; gap: 14px; background: var(--sand); border-radius: var(--radius-card); padding: 36px 34px 32px; color: var(--ink); transition: transform .3s; min-height: 260px; }
  .card:hover { transform: translateY(-3px); color: var(--ink); }
  .badge { width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--olive-deep); }
  h3 { font-family: var(--font-display); font-weight: 500; font-size: 30px; line-height: 1.15; margin: 10px 0 0; }
  p { margin: 0; color: var(--text-muted); font-size: 16px; flex-grow: 1; }
  .more { font-size: 14.5px; font-weight: 500; color: var(--olive); }
</style>
