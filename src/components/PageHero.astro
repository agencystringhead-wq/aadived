---
import { site } from '../data/site';
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  crumb?: { label: string; href: string };
  bookAnchor?: boolean;
  showTimings?: boolean;
}
const { eyebrow, title, intro, crumb, bookAnchor = false, showTimings = false } = Astro.props;
---
<section class="page-hero">
  <div class="wrap inner">
    {crumb && <a class="crumb" href={crumb.href}>&#8592; {crumb.label}</a>}
    <div class="eyebrow">{eyebrow}</div>
    <h1>{title}</h1>
    <p>{intro}</p>
    {showTimings && <p class="timings"><strong>Class timings:</strong> {site.timings.days}, {site.timings.time}</p>}
  </div>
</section>
<section class="soon" id={bookAnchor ? 'book' : undefined}>
  <div class="wrap box section">
    <div class="card">
      <h2>Content coming soon</h2>
      <p>This page is being written. In the meantime, call <a href={`tel:${site.phone.tel}`}>{site.phone.display}</a> or message us on <a href={site.instagram.url}>Instagram</a>.</p>
      <a class="btn btn-primary" href={site.bookHref}>Book a session</a>
    </div>
  </div>
</section>
<style>
  .page-hero { background: var(--ivory); }
  .inner { padding-top: 88px; padding-bottom: 88px; max-width: 900px; margin: 0 auto; }
  .crumb { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 500; margin-bottom: 12px; }
  h1 { font-family: var(--font-display); font-weight: 400; font-size: clamp(48px, 6vw, 86px); line-height: 1.02; letter-spacing: -0.01em; margin: 20px 0 0; color: var(--ink); }
  p { font-size: 19px; line-height: 1.7; color: var(--text-muted); max-width: 640px; margin: 24px 0 0; }
  .timings { margin-top: 16px; font-size: 17px; }
  .timings strong { font-weight: 500; color: var(--ink); }
  .soon { background: var(--sand); }
  .box { padding-top: 80px; padding-bottom: 80px; }
  .card { max-width: 900px; margin: 0 auto; background: var(--ivory); border-radius: var(--radius-card); padding: 48px; }
  h2 { font-family: var(--font-display); font-weight: 500; font-size: 34px; margin: 0; }
  .card p { font-size: 17px; margin: 12px 0 26px; }
  @media (max-width: 768px) { .inner { padding-top: 56px; padding-bottom: 56px; } .card { padding: 32px 24px; } }
</style>
