---
interface Props {
  eyebrow: string;
  title: string; // may contain inline HTML such as <em>
  center?: boolean;
  as?: 'h1' | 'h2';
  eyebrowColor?: string;
}
const { eyebrow, title, center = false, as: Tag = 'h2', eyebrowColor } = Astro.props;
---
<div class:list={['sh', { center }]}>
  <div class="eyebrow" style={eyebrowColor ? `color:${eyebrowColor}` : undefined}>{eyebrow}</div>
  <Tag class="h2" set:html={title} />
</div>
<style>
  .sh { max-width: 720px; }
  .sh.center { text-align: center; margin: 0 auto; }
</style>
