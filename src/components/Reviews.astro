---
import ReviewCard from './ReviewCard.astro';
import { reviews, rating } from '../data/reviews';
import { site } from '../data/site';
import { linkProps } from '../data/links';
import NewTabHint from '../components/NewTabHint.astro';
---
<section class="reviews">
  <div class="wrap section">
    <div class="head">
      <div>
        <div class="eyebrow">Kind words</div>
        <h2>Loved in Hinjawadi</h2>
      </div>
      <div class="score">
        <div class="big">{rating.value}</div>
        <div class="small">Average rating<br />on Google Reviews</div>
      </div>
    </div>
    <div class="grid">
      {reviews.map((r) => <ReviewCard review={r} />)}
    </div>
    <div class="all"><a class="link-arrow" href={site.google.reviews} {...linkProps(site.google.reviews)}>Read all reviews on Google &#8594;<NewTabHint href={site.google.reviews} /></a></div>
  </div>
</section>
<style>
  .reviews { background: var(--ivory); }
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; }
  h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(36px, 4vw, 56px); line-height: 1.08; margin: 16px 0 0; }
  .score { display: flex; align-items: center; gap: 16px; }
  .big { font-family: var(--font-display); font-size: 64px; line-height: 1; color: var(--olive); }
  .small { font-size: 14.5px; color: var(--text-muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 24px; margin-top: 56px; }
  .all { margin-top: 36px; text-align: center; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
