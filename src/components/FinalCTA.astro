---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import logo from '../assets/images/logo-full-white.webp';
---
<section id="book" class="cta on-dark">
  <div class="ring r1" aria-hidden="true"></div>
  <div class="ring r2" aria-hidden="true"></div>
  <div class="wrap inner section">
    <Image src={logo} alt="AadiVed, Mind. Body. Soul" format="webp" height={150} loading="lazy" class="logo" />
    <h2>Begin with <em>AadiVed.</em></h2>
    <p>Book a studio or online session, or ask about one-on-one prenatal care. We usually reply within the day.</p>
    <div class="buttons">
      <a class="btn btn-ivory" href={site.bookHref}>Book a session</a>
      <a class="btn btn-outline-light" href={`tel:${site.phone.tel}`}>Call {site.phone.display}</a>
    </div>
  </div>
</section>
<style>
  .cta { background: var(--olive); color: var(--sand); position: relative; overflow: hidden; }
  .ring { position: absolute; border-radius: 50%; }
  .r1 { width: 560px; height: 560px; border: 1px solid rgba(243,238,228,0.18); left: -160px; top: -200px; }
  .r2 { width: 420px; height: 420px; border: 1px solid rgba(243,238,228,0.14); right: -120px; bottom: -180px; }
  .inner { position: relative; text-align: center; }
  .inner :global(.logo) { height: 150px; width: auto; display: block; margin: 0 auto; }
  h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(42px, 5vw, 72px); line-height: 1.05; margin: 40px auto 0; max-width: 820px; color: var(--ivory); }
  h2 em { font-style: italic; }
  p { max-width: 560px; margin: 22px auto 0; color: var(--on-dark); }
  .buttons { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; margin-top: 38px; }
  @media (max-width: 768px) { .inner :global(.logo) { height: 110px; } }
</style>
