---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { linkProps } from '../data/links';
import NewTabHint from '../components/NewTabHint.astro';
---
<div class="util">
  <div class="wrap bar">
    <div class="group">
      <span class="item"><Icon name="pin" size={14} />{site.address.short}</span>
      <span class="item extra">Studio &amp; online sessions</span>
      <span class="item extra">{site.timings.daysShort}, {site.timings.time}</span>
    </div>
    <div class="group">
      <a class="item" href={`tel:${site.phone.tel}`}><Icon name="phone" size={14} />{site.phone.display}</a>
      <a class="item extra" href={site.instagram.url} {...linkProps(site.instagram.url)}><Icon name="instagram" size={14} />{site.instagram.handle}<NewTabHint href={site.instagram.url} /></a>
    </div>
  </div>
</div>
<style>
  .util { background: var(--olive-deep); color: var(--on-dark); font-size: 13.5px; letter-spacing: 0.02em; }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding-top: 0; padding-bottom: 0; min-height: 42px; }
  .group { display: flex; gap: 22px; align-items: center; flex-wrap: wrap; }
  .item { display: inline-flex; align-items: center; gap: 8px; color: var(--on-dark); min-height: 24px; }
  a.item { min-height: 44px; }
  a.item:hover { color: #fff; }
  @media (max-width: 960px) { .extra { display: none; } .bar { justify-content: center; } }
</style>
