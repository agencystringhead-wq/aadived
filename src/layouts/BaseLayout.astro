---
// Latin subsets for Cormorant and Jost, Devanagari for the name meaning section (content is en-IN).
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/jost/latin-300.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
import '@fontsource/tiro-devanagari-hindi/devanagari-400.css';
import corm400 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import corm400i from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-italic.woff2?url';
import jost400 from '@fontsource/jost/files/jost-latin-400-normal.woff2?url';
// The italic face is preloaded too: the hero headline has an italic word, and a late swap shifts the layout
const preloadFonts = [corm400, corm400i, jost400];
import '../styles/global.css';

import UtilityBar from '../components/UtilityBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../data/site';
import { getSeo, type PageSeo } from '../data/seo';
import { websiteSchema } from '../data/schema';

interface Crumb { name: string; path: string }
interface Props {
  /** Normally omitted: title, description, OG image and robots come from src/data/seo.ts. */
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'profile' | 'article';
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  jsonLd?: (Record<string, unknown> | null)[];
}

const props = Astro.props;
// Pages in src/data/seo.ts need no props. Dynamic pages (journal posts) pass their own.
const entry: PageSeo | undefined = props.title ? undefined : getSeo(Astro.url.pathname);
const title = props.title ?? entry!.title;
const description = props.description ?? entry?.description ?? site.description;
const ogImage = props.ogImage ?? entry?.ogImage ?? '/og-image.jpg';
const ogType = props.ogType ?? entry?.ogType ?? 'website';
const noindex = props.noindex ?? entry?.noindex ?? false;
const { breadcrumbs, jsonLd = [] } = props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogUrl = new URL(ogImage, Astro.site ?? site.url).href;

const speculation = {
  prefetch: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/*.*' } }] }, eagerness: 'moderate' }],
};

const schemas: Record<string, unknown>[] = [websiteSchema(), ...jsonLd.filter((s): s is Record<string, unknown> => Boolean(s))];
if (breadcrumbs?.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.path, site.url).href,
    })),
  });
}
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#4B5238" />
    {preloadFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/webp" href="/favicon-32.webp" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="AadiVed Journal" href="/journal/rss.xml" />
    <!-- Prefetch a page when the visitor hovers a link to it. Chrome only, no JavaScript, ignored elsewhere. -->
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculation)} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <!-- Google tag (gtag.js), loaded only after the visitor accepts analytics cookies in the banner.
         Until then nothing is requested from Google, no cookie is set, and window.gtag does not exist.
         The choice is kept in localStorage for a year; "Cookie settings" in the footer reopens the banner. -->
    <script is:inline>
      (function () {
        var ID = 'G-VHMFXTP57R';
        var KEY = 'aadived-analytics-consent';
        var YEAR = 365 * 24 * 60 * 60 * 1000;
        var gtagFn = null;
        function read() {
          try {
            var v = JSON.parse(localStorage.getItem(KEY));
            if (v && (v.v === 'granted' || v.v === 'denied') && Date.now() - v.t < YEAR) return v.v;
          } catch (e) {}
          return null;
        }
        function write(v) {
          try { localStorage.setItem(KEY, JSON.stringify({ v: v, t: Date.now() })); } catch (e) {}
        }
        function clearCookies() {
          try {
            var host = location.hostname;
            var parts = host.split('.');
            var domains = [host, '.' + host];
            if (parts.length > 2) domains.push('.' + parts.slice(-2).join('.'));
            document.cookie.split(';').forEach(function (c) {
              var n = c.split('=')[0].trim();
              if (n === '_ga' || n.indexOf('_ga_') === 0 || n === '_gid' || n.indexOf('_gat') === 0) {
                document.cookie = n + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
                domains.forEach(function (d) { document.cookie = n + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/; domain=' + d; });
              }
            });
          } catch (e) {}
        }
        function load() {
          window['ga-disable-' + ID] = false;
          if (gtagFn) { window.gtag = gtagFn; return; }
          window.dataLayer = window.dataLayer || [];
          gtagFn = function () { window.dataLayer.push(arguments); };
          window.gtag = gtagFn;
          gtagFn('js', new Date());
          gtagFn('config', ID);
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ID;
          document.head.appendChild(s);
        }
        window.aadivedConsent = {
          get: read,
          accept: function () { write('granted'); load(); },
          decline: function () {
            write('denied');
            window['ga-disable-' + ID] = true;
            window.gtag = undefined;
            clearCookies();
          },
        };
        // Without consent, remove any analytics cookies left from before this banner existed
        if (read() === 'granted') load();
        else clearCookies();
      })();
    </script>
    <!-- Event tracking (GA4): phone_click for every tel: link, plus window.aadivedTrack() for the contact form.
         Registered once. Every call is guarded and wrapped, so a blocked GA never affects the page.
         No personal data is sent: not the phone number, and nothing typed into the form. Add ?ga_debug=1 to see events in DebugView. -->
    <script is:inline>
      (function () {
        if (window.__aadivedTrack) return;
        window.__aadivedTrack = true;
        var debug = /[?&]ga_debug=1(&|$)/.test(location.search);
        window.aadivedTrack = function (name, params) {
          try {
            if (typeof window.gtag !== 'function') return;
            if (debug) params.debug_mode = true;
            window.gtag('event', name, params);
          } catch (e) {}
        };
        document.addEventListener('click', function (e) {
          try {
            var a = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
            if (!a) return;
            // Link text without any digits, so the number itself is never sent
            var text = (a.textContent || '').replace(/[+\d][\d\s().-]*\d/g, '').replace(/\s+/g, ' ').trim().slice(0, 80);
            window.aadivedTrack('phone_click', {
              link_location: a.getAttribute('data-track-location') || 'unknown',
              page_path: location.pathname,
              link_text: text || 'phone number',
            });
          } catch (err) {}
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <CookieBanner />
    <UtilityBar />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>
