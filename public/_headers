# Cloudflare Pages response headers. Docs: https://developers.cloudflare.com/pages/configuration/headers/
# HTML keeps Cloudflare's default (revalidate on every visit, so a new deploy shows straight away).

# Security headers on every response
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()

# Built assets have a content hash in the file name, so they can be cached for a year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Per-page social preview images and icons: unhashed names, so cache for a week
/og/*
  Cache-Control: public, max-age=604800
/og-image.jpg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon-32.webp
  Cache-Control: public, max-age=604800
/favicon-180.webp
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800

# Small files that may change: cache for an hour
/site.webmanifest
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap-index.xml
  Cache-Control: public, max-age=3600
/sitemap-0.xml
  Cache-Control: public, max-age=3600
